generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  notes       Note[]
  quizResults QuizResult[]
  studyTasks  StudyTask[]
  subjects    Subject[]
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
model QuizResult {
  id             Int      @id @default(autoincrement())
  score          Int
  totalQuestions Int
  percentage     Int
  subject        String?
  createdAt      DateTime @default(now())

  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
model StudyTask {
  id          Int      @id @default(autoincrement())
  title       String
  subject     String
  description String?
  dueDate     DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
model Subject {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}